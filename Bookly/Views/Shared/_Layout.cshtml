<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title - Bookly</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
   
    <link rel="stylesheet" href="~/css/custom.css">

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Lora&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">


</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/Home">Bookly</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="/Books">Books</a>
                    </li>
                   
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Authors" asp-action="Index">Authors</a>
                    </li>
                </ul>
                <div class="d-flex">
                    <input class="form-control me-2 shadow-sm" type="search" placeholder="Search books..." autocomplete="off" id="searchInput"> 
                    <button class="btn btn-outline-dark" onclick="searchBooks()">Search</button>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <!-- apare doar dacă utilizatorul este logat -->
                        <a href="/Account/Profile" class="btn btn-outline-dark d-flex align-items-center gap-2 rounded-pill px-3 ms-2">
                            <i class="bi bi-person"></i>
                            
                        </a>
                    }
                    else
                    {
                        <!--apare doar dacă utilizatorul nu este logat -->
                        <a href="/html/login.html" class="btn btn-dark rounded-pill px-4 ms-2">Login</a>
                    }

@*                     <a href="html/login.html" class="btn btn-dark ms-2">Login</a>
 *@                </div>
            </div>
        </div>
    </nav>
 
    <div>
        @RenderBody()
    </div>

    <footer class="text-center">
        <p>&copy; 2026 Bookly - A world of Books, Yours.</p>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>


    @* <script src="~/js/site.js" asp-append-version="true"></script> *@
    <script src="~/js/home.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)


</body>
</html>
