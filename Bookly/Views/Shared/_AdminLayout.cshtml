@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bookly Admin</title>

    <link href="~/css/bootstrap.min.css" rel="stylesheet">
        <link href="~/css/jquery.dataTables.min.css" rel="stylesheet">
       <link href="~/css/select2.min.css" rel="stylesheet">
        <link href="~/css/custom.css" rel="stylesheet">
                 
</head>
<body>


    <div id="wrapper">
        <nav id="sidebar">
            <div class="sidebar-heading fw-bold p-3 border-bottom">Bookly Control Panel</div>
            <ul class="list-unstyled components">
                <li>
                    <a href="#" class="nav-link-ajax active" data-page="/html/manageBooks.html">
                        <i class="bi bi-book"></i> Manage Books
                    </a>
                </li>
                <li>
                    <a href="#" class="nav-link-ajax" data-page="/html/manageCategories.html">
                        <i class="bi bi-tags"></i> Manage Categories
                    </a>
                </li>
                <li>
                    <a href="#" class="nav-link-ajax" data-page="/html/manageAuthors.html">
                        <i class="bi bi-person"></i> Manage Authors
                    </a>
                </li>
                <li>
                    <a href="#" class="nav-link-ajax" data-page="/html/manageBorrows.html">
                        <i class="bi bi-journal-bookmark"></i> Manage Borrows
                    </a>
                </li>
            </ul>
        </nav>

        <div id="page-content-wrapper">
            <nav class="navbar navbar-expand-lg navbar-light bg-transparent border-bottom mb-4 pb-3">
                <div class="container-fluid p-0 d-flex align-items-center">
                    <button class="btn btn-outline-secondary me-3" id="sidebarToggle">
                        ☰ Toggle Menu
                    </button>
                    <h4 class="fw-bold m-0" style="font-family: 'Playfair Display', serif;" id="admin-page-title">Manage Books</h4>
                </div>
            </nav>

            <div id="app">
            </div>
        </div>
    </div>

    <script src="~/js/jquery-3.7.1.min.js"></script>

    <script src="~/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/jquery.dataTables.min.js"></script>
    <script src="~/js/select2.min.js"></script>

    <script src="~/js/manageBooks.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function() {
            $('#app').load('/html/manageBooks.html');

            $('.nav-link-ajax').on('click', function(e) {
                e.preventDefault();

                $('.nav-link-ajax').removeClass('active');
                $(this).addClass('active');

                const page = $(this).data('page'); 
                const title = $(this).text().trim();

                $('#admin-page-title').text(title);

                $('#app').fadeOut(150, function() {
                    $(this).load(page, function() {
                        $(this).fadeIn(150);
                    });
                });
            });

            $('#sidebarToggle').on('click', function(e) {
                e.preventDefault();
                $('#wrapper').toggleClass('toggled');
            });
        });
    </script>

   
</body>
</html>



